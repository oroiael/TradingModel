# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#     cp .env.example .env
#
# In a Codespace, do NOT create .env at all. Set these as encrypted Codespaces
# secrets instead (github.com/settings/codespaces); they arrive as environment
# variables and python-dotenv will leave the existing values alone.
#
# Read by the ThetaData option loaders: soxl_options_greeks_*.py,
# soxl_historical_greeks*.py, hybrid_collar_backtester*.py and the other
# modules that call load_dotenv(). Note these only get you as far as
# authenticating — the thetadata client also needs the ThetaData Terminal
# running locally, which is why those scripts do not work in a Codespace.

THETADATA_USERNAME=
THETADATA_PASSWORD=
