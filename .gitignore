__pycache__/
*.pyc

drift_lab/out/*.parquet
env/

# band_lab/phase1: bulky regenerable logs (summary tables ARE committed)
band_lab/phase1/out/decision_log_*.csv
band_lab/phase1/out/trade_log_*.csv
band_lab/phase1/out/parity_daily_*.csv
band_lab/phase1/out/spec_literal_*.csv

# band_lab/live: runtime state and local secrets — never committed
band_lab/live/state/
band_lab/live/out/
band_lab/live/config.local.toml
band_lab/live/config.local.json

# Session logs from run.py / watchdog.py — they carry balances, share counts
# and fill prices. RUNBOOK_WINDOWS.md §G and RUNBOOK_MACOS.md §G write here.
logs/

# vix_lab: bulky regenerable logs (summary tables ARE committed)
vix_lab/out/trades_*.csv
vix_lab/out/*.txt

# band_lab/v2_dev: V21 writes one row per trade per configuration (~10MB).
# Regenerate with `reparam.py --run`; `--verify` then rebuilds every summary
# number from them. summary.csv IS committed, same split as phase1/out above.
band_lab/v2_dev/out/reparam/trades__*.csv
