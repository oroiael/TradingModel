{
  "name": "TradingModel",

  // Python 3.12: band_lab/live/DEPLOYMENT.md sets the floor at 3.11+, the
  // repo's own venv is 3.12, and the `thetadata` client (requirements-local.txt)
  // publishes nothing installable below 3.12 — its whole 0.x line is yanked.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    // The data in this repo is ~6.3 GB across 822 CSVs tracked in Git LFS.
    // Without this feature the checkout gives you pointer files, and every
    // backtester fails with a parse error on a 130-byte "CSV".
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

  // Sized for the grid searches (massive_grid_optimizer, the_titan_grid,
  // hedge_optimizer_grid), not for editing. The 64 GB disk matters: the LFS
  // data plus a 387 MB .git plus sweep output does not sit comfortably on the
  // 32 GB default. Lower these if your plan will not grant the machine —
  // see .devcontainer/README.md.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "64gb"
  },

  "containerEnv": {
    // 38 modules import matplotlib. There is no display in a container, so
    // pick the file-writing backend before anything calls pyplot.
    "MPLBACKEND": "Agg",
    "PYTHONDONTWRITEBYTECODE": "1"
  },

  // Surfaced in the Codespaces UI so these are set as encrypted Codespaces
  // secrets rather than committed to .env. Only needed if you run the
  // ThetaData loaders, which additionally require a local Terminal process —
  // see .devcontainer/README.md for why that does not work in a Codespace.
  "secrets": {
    "THETADATA_USERNAME": {
      "description": "ThetaData account email. Set at github.com/settings/codespaces."
    },
    "THETADATA_PASSWORD": {
      "description": "ThetaData account password. Never commit this to .env."
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        // Keep the LFS data and the vendored SDK out of the file watcher and
        // out of search; otherwise the editor indexes several GB on start.
        "files.watcherExclude": {
          "**/raw_data/**": true,
          "**/TWS API/**": true,
          "**/*.csv": true
        },
        "search.exclude": {
          "**/raw_data/**": true,
          "**/TWS API/**": true,
          "**/env/**": true
        }
      }
    }
  },

  "remoteUser": "vscode"
}
