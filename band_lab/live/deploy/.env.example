# Copy to .env in this directory and fill in. .env is gitignored repo-wide.
#
#   cp .env.example .env
#
# These are PAPER credentials. Paper login does not raise an IBKR Mobile 2FA
# prompt, which is what makes the container able to start unattended.

TWS_USERID=
TWS_PASSWORD=

# Optional — set a password to enable VNC on 5900 for debugging the Gateway's
# GUI, then uncomment the matching line in docker-compose.yml. Leave empty and
# VNC stays off, which is the right default for anything long-running.
VNC_SERVER_PASSWORD=
